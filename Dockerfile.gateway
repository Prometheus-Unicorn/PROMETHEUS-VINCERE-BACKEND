# Prometheus Vincere — Standalone MCP & AI Gateway
# Multi-protocol server supporting:
#   1. Model Context Protocol (MCP) over SSE (/mcp)  → Claude Desktop & CLI
#   2. OpenAPI 3.1.0 Actions (/openapi.json, /api/v1/actions/*) → ChatGPT Custom GPTs
#   3. REST endpoints for headless developers / CLI automation
#
# Optimised for free-tier cloud hosting (Render, Fly.io, Hugging Face Spaces).
# No GPU required — CPU-only, ~30 MB RAM idle.

FROM node:22-bookworm-slim

WORKDIR /app/backend

# Install tsx runner globally (tiny, no build step needed)
RUN npm install -g tsx

# Copy package manifest and tsconfig first (layer-cache friendly)
COPY backend/package.json ./package.json
COPY backend/tsconfig.json ./tsconfig.json

# Install only production dependencies (skip remotion, puppeteer, etc.)
RUN npm install --omit=dev 2>/dev/null || true

# Copy gateway source code only — nothing else from the repo
COPY backend/src/gateway ./src/gateway

# Expose the gateway port
EXPOSE 3100

ENV PORT=3100 \
    GATEWAY_PORT=3100 \
    NODE_ENV=production

# Lightweight healthcheck (no extra dependencies)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3100/healthz', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["tsx", "src/gateway/server.ts"]
